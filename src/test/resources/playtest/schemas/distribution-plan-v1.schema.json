{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bc.playtest_distribution_plan.v1",
  "description": "Closed exact-binomial family authoring contract; sample membership/N, bin definitions, hypotheses, alternatives and <=1% family alpha are fixed BEFORE outcome capture. Runtime validator enforces cross-field constraints; schema alone is not approval.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "reviewer", "reviewed_at", "plan_id", "family_id", "candidate_sha256", "sampling_unit", "independent_source", "sampling_frame_sha256", "eligible_unit_ids", "selected_unit_ids", "bins", "hypotheses"],
  "properties": {
    "schema": {"const": "bc.playtest_distribution_plan.v1"},
    "status": {"const": "reviewed"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "plan_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha"},
    "sampling_unit": {"type": "string", "minLength": 1},
    "independent_source": {"type": "string", "minLength": 1},
    "sampling_frame_sha256": {"$ref": "#/$defs/sha"},
    "eligible_unit_ids": {"type": "array", "minItems": 1, "maxItems": 8192, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selected_unit_ids": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "bins": {"type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "hypotheses": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false,
      "required": ["bin_id", "null_rate", "predetermined_alternative", "alpha_parts_per_million", "sampler_semantics"],
      "properties": {
        "bin_id": {"type": "string", "minLength": 1},
        "null_rate": {"$ref": "#/$defs/rational"},
        "predetermined_alternative": {"$ref": "#/$defs/rational"},
        "alpha_parts_per_million": {"type": "integer", "minimum": 1, "maximum": 10000},
        "sampler_semantics": {"enum": ["ideal-independent-bernoulli-v1", "uniform-nextfloat-lt-v1"]}
      }}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {"type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"], "properties": {
        "numerator": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "denominator": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }}
  }
}
