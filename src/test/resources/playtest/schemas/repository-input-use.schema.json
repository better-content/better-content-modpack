{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bc.repository_input_use.v1",
  "description": "Historical proposed v1 self-reported input-use claim only; v3 runner MUST use actual Java worker observer v2 instead. This is not packaged-runtime or test execution authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "repository", "run_id", "reviewed_plan_sha256", "producer_path", "producer_sha256", "artifact_loaded", "observed_process_pid", "observed_process_start", "captured_at", "invocation_tasks", "report_leaf_tasks", "used_inputs"],
  "properties": {
    "schema": {"const": "bc.repository_input_use.v1"},
    "scope": {"const": "source-only-not-packaged-runtime"},
    "repository": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "reviewed_plan_sha256": {"$ref": "#/$defs/sha"},
    "producer_path": {"type": "string", "minLength": 1},
    "producer_sha256": {"$ref": "#/$defs/sha"},
    "artifact_loaded": {"const": false},
    "observed_process_pid": {"type": "integer", "minimum": 1},
    "observed_process_start": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "invocation_tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "report_leaf_tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "used_inputs": {"type": "object", "additionalProperties": false, "required": ["toolchain", "providers", "artifact"], "properties": {
      "toolchain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/used"}},
      "providers": {"type": "array", "items": {"$ref": "#/$defs/used"}},
      "artifact": {"type": "array", "maxItems": 0}
    }}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "used": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256"], "properties": {
      "relative_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}
    }}
  }
}
