{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bc.playtest_evidence.v3",
  "$defs": {
    "binding": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "checkpoint_ref": {"type": "object", "required": ["id", "receipt"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "receipt": {"$ref": "#/$defs/binding"}}},
    "index": {"type": "object", "required": ["schema", "catalogue_sha256", "campaign", "case_results", "epochs", "checkpoints", "lifecycle", "visual_review", "gui_review", "client_frame_review", "visual_release_run_id", "repository_receipts", "log_review"], "properties": {"schema": {"const": "bc.playtest_evidence_index.v3"}, "catalogue_sha256": {"$ref": "#/$defs/hash"}, "campaign": {"$ref": "#/$defs/binding"}, "case_results": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "epochs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}}, "checkpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}}, "lifecycle": {"type": "object"}, "visual_review": {"$ref": "#/$defs/binding"}, "gui_review": {"$ref": "#/$defs/binding"}, "client_frame_review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]}, "visual_release_run_id": {"type": "string"}, "repository_receipts": {"type": "object"}, "log_review": {"$ref": "#/$defs/binding"}}},
    "campaign": {"type": "object", "required": ["schema", "status", "diagnostic", "campaign_id", "lineage_id", "catalogue_sha256", "profile_sha256", "candidate", "bindings", "branch_ids", "branch_results", "epoch_receipts", "checkpoint_receipts", "case_results", "events", "ledger", "worlds_created", "storage_budget", "tools", "hardware", "fixture_overrides", "cleanup_complete", "failure", "started_at", "completed_at", "test_support_sha256"], "properties": {"schema": {"const": "bc.playtest_campaign.v3"}, "status": {"enum": ["passed", "failed", "blocked", "inconclusive", "diagnostic"]}, "diagnostic": {"type": "boolean"}, "campaign_id": {"type": "string"}, "lineage_id": {"type": "string"}, "candidate": {"type": "object"}, "branch_ids": {"type": "array", "items": {"type": "string"}}, "epoch_receipts": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "checkpoint_receipts": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "case_results": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "hardware": {"$ref": "#/$defs/binding"}, "fixture_overrides": {"$ref": "#/$defs/binding"}, "cleanup_complete": {"type": "boolean"}, "catalogue_sha256": {"$ref": "#/$defs/hash"}, "profile_sha256": {"$ref": "#/$defs/hash"}, "bindings": {"type": "object"}, "branch_results": {"type": "array", "items": {"type": "object", "required": ["id", "state", "input_checkpoint", "output_checkpoint", "epoch_ids", "case_ids"], "properties": {"id": {"type": "string"}, "state": {"type": "string"}, "input_checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint_ref"}]}, "output_checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint_ref"}]}, "epoch_ids": {"type": "array", "items": {"type": "string"}}, "case_ids": {"type": "array", "items": {"type": "string"}}}}}, "events": {"$ref": "#/$defs/binding"}, "ledger": {"$ref": "#/$defs/binding"}, "worlds_created": {"const": 1}, "storage_budget": {"$ref": "#/$defs/binding"}, "tools": {"type": "object", "required": ["portablemc", "bubblewrap"], "additionalProperties": false, "properties": {"portablemc": {"$ref": "#/$defs/binding"}, "bubblewrap": {"$ref": "#/$defs/binding"}}}, "failure": {"type": ["null", "string"]}, "started_at": {"type": "string"}, "completed_at": {"type": "string"}, "test_support_sha256": {"$ref": "#/$defs/hash"}}},
    "epoch": {"type": "object", "required": ["schema", "id", "branch_id", "campaign_id", "lineage_id", "native_session_id", "input_checkpoint", "restored", "started_at", "completed_at", "status", "closure", "event_log", "native_requests", "native_observations", "case_results", "client_stream"], "properties": {"schema": {"const": "bc.playtest_epoch.v3"}, "id": {"type": "string"}, "branch_id": {"type": "string"}, "campaign_id": {"type": "string"}, "lineage_id": {"type": "string"}, "native_session_id": {"type": "string"}, "input_checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint_ref"}]}, "restored": {"type": ["null", "object"]}, "started_at": {"type": "string"}, "completed_at": {"type": "string"}, "status": {"type": "string"}, "closure": {"type": ["null", "object"]}, "event_log": {"$ref": "#/$defs/binding"}, "native_requests": {"$ref": "#/$defs/binding"}, "native_observations": {"$ref": "#/$defs/binding"}, "case_results": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "client_stream": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["native_session_id", "capabilities", "native_requests", "native_observations", "input_log"], "additionalProperties": false, "properties": {"native_session_id": {"type": "string"}, "capabilities": {"$ref": "#/$defs/binding"}, "native_requests": {"$ref": "#/$defs/binding"}, "native_observations": {"$ref": "#/$defs/binding"}, "input_log": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]}}}]}}},
    "case_result": {"type": "object", "required": ["schema", "case_id", "case_sha256", "catalogue_sha256", "profile_sha256", "candidate", "state", "diagnostic", "run_id", "world_id", "started_at", "completed_at", "assertions", "cleanup_complete", "provisioned_targets", "branch_id", "input_checkpoint", "epoch_receipts", "trials"], "properties": {"schema": {"const": "bc.playtest_case_result.v3"}, "case_id": {"type": "string"}, "branch_id": {"type": ["null", "string"]}, "input_checkpoint": {"type": ["null", "object"]}, "epoch_receipts": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "trials": {"type": "array", "items": {"$ref": "#/$defs/binding"}}}},
    "trial": {"type": "object", "required": ["schema", "case_id", "trial_id", "target_id", "epoch_id", "native_session_id", "input_checkpoint", "parameters_sha256", "state", "started_at", "completed_at", "native_actions", "provisioned_targets", "sampling_claims", "sampling_ledger", "cleanup_complete", "failure"], "properties": {"schema": {"const": "bc.playtest_trial.v3"}, "case_id": {"type": "string"}, "trial_id": {"type": "string"}, "target_id": {"type": "string"}, "epoch_id": {"type": "string"}, "native_session_id": {"type": "string"}, "input_checkpoint": {"$ref": "#/$defs/checkpoint_ref"}, "parameters_sha256": {"$ref": "#/$defs/hash"}, "state": {"type": "string"}, "started_at": {"type": "string"}, "completed_at": {"type": "string"}, "native_actions": {"$ref": "#/$defs/binding"}, "provisioned_targets": {"type": "array", "items": {"type": "string"}}, "sampling_claims": {"type": "array", "items": {"type": "object", "required": ["sequence", "sha256"], "additionalProperties": false, "properties": {"sequence": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}}}, "sampling_ledger": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]}, "cleanup_complete": {"type": "boolean"}, "failure": {"type": ["null", "string"]}}},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "oneOf": [{"$ref": "#/$defs/index"}, {"$ref": "#/$defs/campaign"}, {"$ref": "#/$defs/epoch"}, {"$ref": "#/$defs/case_result"}, {"$ref": "#/$defs/trial"}]
}
