{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bc.playtest_manifest.v3",
  "type": "object",
  "required": ["schema", "revision", "authoring", "candidate", "profile", "test_support", "repositories", "rosters", "acquisitions", "cases", "branches", "storage", "tooling"],
  "properties": {
    "schema": {"const": "bc.playtest_manifest.v3"},
    "revision": {"type": "string"}, "authoring": {"type": "object"}, "candidate": {"type": "object"},
    "profile": {"type": "object"}, "test_support": {"type": "object"},
    "repositories": {"type": "array"}, "rosters": {"type": "array"},
    "acquisitions": {"type": "array"}, "cases": {"type": "array"},
    "storage": {"type": "object", "required": ["checkpoint_budget_bytes"], "properties": {"checkpoint_budget_bytes": {"type": "integer", "minimum": 1}}},
    "tooling": {"type": "object", "required": ["portablemc", "bubblewrap"], "additionalProperties": false,
      "properties": {"portablemc": {"$ref": "#/$defs/binding"}, "bubblewrap": {"$ref": "#/$defs/binding"}}},
    "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}}
  },
  "$defs": {
    "binding": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "branch": {"type": "object", "additionalProperties": false,
      "required": ["id", "input_checkpoint", "case_ids", "output_checkpoint", "depends_on", "state_policy", "isolation_contract"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"}, "input_checkpoint": {"type": "string"},
        "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "output_checkpoint": {"type": ["string", "null"]},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "ordering_dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
        "state_policy": {"enum": ["isolated", "carry-forward"]},
        "isolation_contract": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]}}
    }
  }
}
