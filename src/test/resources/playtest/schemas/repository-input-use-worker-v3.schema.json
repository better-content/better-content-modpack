{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bc.repository_input_use_worker.v3",
  "description": "Actual nonshipping Test/JavaExec JVM class-definition-stage observation. Incomplete/union/transformer states never qualify. Not resource file-access or packaged-runtime evidence.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scope", "observation_scope", "status", "run_id", "repository", "task", "reviewed_plan_sha256", "producer_sha256", "config_sha256", "event_stream_path", "event_stream_nonce", "health_page_path", "health_nonce", "snapshot_stream_sequence", "observed_process_pid", "observed_process_start", "captured_at", "java_executable", "java_executable_sha256", "java_version", "java_runtime_version", "java_vendor", "java_home", "java_vm_name", "java_vm_version", "java_vm_vendor", "jar_mr_policy", "jar_version_override", "jar_runtime_feature", "bootstrap_pre_agent", "jvm_arguments", "unsupported", "instrumentation_agents", "module_access_changes", "union_sources", "task_roster_path", "task_roster_sha256", "task_execution_policy", "task_class_path", "jdk_components", "class_path", "module_path", "code_sources", "class_definitions"],
  "properties": {
    "schema": {"const": "bc.repository_input_use_worker.v3"}, "scope": {"const": "source-only-not-packaged-runtime"},
    "observation_scope": {"const": "class-definition-stage-only-resource-access-unobserved"},
    "status": {"enum": ["bounded-file-class-stage", "incomplete"]},
    "run_id": {"type": "string", "minLength": 1}, "repository": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1}, "reviewed_plan_sha256": {"$ref": "#/$defs/sha"},
    "producer_sha256": {"$ref": "#/$defs/sha"}, "config_sha256": {"$ref": "#/$defs/sha"},
    "event_stream_path": {"type": "string", "minLength": 1},
    "event_stream_nonce": {"type": "string", "minLength": 36},
    "health_page_path": {"type": "string", "minLength": 1},
    "health_nonce": {"type": "string", "minLength": 36},
    "snapshot_stream_sequence": {"type": "integer", "minimum": 1, "maximum": 65539},
    "observed_process_pid": {"type": "integer", "minimum": 1},
    "observed_process_start": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "java_executable": {"type": "string", "minLength": 1}, "java_executable_sha256": {"$ref": "#/$defs/sha"},
    "java_version": {"type": "string", "minLength": 1},
    "java_runtime_version": {"type": "string", "minLength": 1},
    "java_vendor": {"type": "string", "minLength": 1},
    "java_home": {"type": "string", "minLength": 1},
    "java_vm_name": {"type": "string", "minLength": 1},
    "java_vm_version": {"type": "string", "minLength": 1},
    "java_vm_vendor": {"type": "string", "minLength": 1},
    "jar_mr_policy": {"enum": ["<unset>", "true", "false", "force"]},
    "jar_version_override": {"type": "string", "minLength": 1},
    "jar_runtime_feature": {"type": "integer", "minimum": 8, "maximum": 99},
    "bootstrap_pre_agent": {"type": "integer", "minimum": 0},
    "jvm_arguments": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}},
    "unsupported": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "instrumentation_agents": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/entry"}},
    "union_sources": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}},
    "module_access_changes": {"type": "array", "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["module", "package", "opened_to", "handler_path", "handler_sha256", "module_instances"], "properties": {"module": {"const": "cpw.mods.securejarhandler"}, "package": {"const": "cpw.mods.niofs.union"}, "opened_to": {"const": "observer-unnamed-module"}, "handler_path": {"type": "string", "minLength": 1}, "handler_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "module_instances": {"type": "integer", "minimum": 1, "maximum": 16}}}},
    "task_roster_path": {"type": "string", "minLength": 1},
    "task_roster_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task_execution_policy": {"enum": ["Test/maxParallelForks=1/forkEvery=0", "JavaExec/one-task-worker"]},
    "task_class_path": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/taskEntry"}},
    "jdk_components": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/entry"}},
    "class_path": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}},
    "module_path": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}},
    "code_sources": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}},
    "class_definitions": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "loader_id", "source", "bytes_sha256", "selected_entry"],
      "properties": {"name": {"type": "string", "minLength": 7}, "loader_id": {"type": "integer", "minimum": -1, "not": {"const": 0}}, "source": {"type": "string", "minLength": 1}, "bytes_sha256": {"$ref": "#/$defs/sha"}, "selected_entry": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "kind", "files", "size_bytes"], "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"},
        "kind": {"enum": ["file", "directory"]}, "files": {"type": "integer", "minimum": 0, "maximum": 65536},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}
      }},
    "taskEntry": {"oneOf": [{"$ref": "#/$defs/entry"},
      {"type": "object", "additionalProperties": false,
       "required": ["path", "sha256", "kind", "files", "size_bytes"],
       "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"},
         "kind": {"const": "absent"}, "files": {"const": 0}, "size_bytes": {"const": 0}}}]}
  }
}
